{
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "DEV",
        "EXPO_PUBLIC_USE_LOCAL_API": "true"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "developmentClient": true
      },
      "channel": "development"
    },
    "qa": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "QA",
        "EXPO_PUBLIC_QA_API_HOST": "qa-api.simplyrenit.com"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleQa"
      },
      "channel": "qa"
    },
    "release": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "PROD",
        "EXPO_PUBLIC_PROD_API_HOST": "api.simplyrenit.com"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "release"
    }
  }
}
