{
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "DEV"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "developmentClient": true
      },
      "channel": "development"
    },
    "qa": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "QA"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "qa"
    },
    "release": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "PROD"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "release"
    }
  }
}
