rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in conversation(conversationId).data.participantIds;
    }

    match /conversations/{conversationId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      allow update: if isParticipant(conversationId)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.initialParticipants == resource.data.initialParticipants
        && request.resource.data.startedBy == resource.data.startedBy;

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow get, list: if isParticipant(resource.data.conversationId);

      allow create: if isParticipant(request.resource.data.conversationId)
        && request.resource.data.senderUid == request.auth.uid;

      allow update: if isParticipant(resource.data.conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["message"])
        && resource.data.type == "make_offer";

      allow delete: if false;
    }

    match /blocked/{blockId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.initiatorUid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.initiatorUid;
    }

    match /users/{userId} {
      allow create, update: if signedIn() && userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
