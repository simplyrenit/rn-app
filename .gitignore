# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.vendor/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
config/environments/qa-test-accounts.local.json

# typescript
*.tsbuildinfo

%ProgramData%/Microsoft/Windows/UUS/State/_active.uusver

# IDE (Android Studio / IntelliJ)
.idea/

# Local QA captures and device state (keep app assets under assets/ versioned)
/*.png
/*.xml
/*.db
*.swp

# Local Xcode archives (multi-hundred-MB)
/build/

# Output of tools/figma-pull.mjs; regenerate rather than commit
/design/figma/*.png
/design/figma/tree.json

.claude/

# Device captures and Figma exports: they can show QA users, emails and listing
# photos, so they stay local. Files already tracked here stay tracked.
/design/app/
/design/figma-images/
